# The demo profile's embedded LDAP server (spring.ldap.embedded.*). Every user's password is "demo".
# an, binh, chi, dung and minh are the demo members (Dataset.MEMBERS); lan is in the directory but not a member, so she
# has to request access; khach is a visitor without access.
dn: dc=acme,dc=vn
objectClass: top
objectClass: domain
dc: acme

dn: ou=people,dc=acme,dc=vn
objectClass: top
objectClass: organizationalUnit
ou: people

dn: uid=an,ou=people,dc=acme,dc=vn
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: an
cn: Nguyễn Thị An
sn: Nguyễn
displayName: Nguyễn Thị An
mail: an.nguyen@acme.vn
userPassword: demo

