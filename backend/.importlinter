[importlinter]
root_package = tracker
include_external_packages = True

[importlinter:contract:layers]
name = Clean architecture layers
type = layers
layers =
    (tracker.bootstrap)
    tracker.adapters
    tracker.application
    tracker.domain

[importlinter:contract:domain-pure]
name = Domain has no framework or IO imports
type = forbidden
source_modules =
    tracker.domain
    tracker.application
forbidden_modules =
    fastapi
    sqlalchemy
    httpx
    alembic
    openpyxl
    cryptography
